{
  "name": "devtools-launcher",
  "version": "1.0.0",
  "description": "Lightning-fast CLI launcher for local development tools with live reload, socket inspection, and hot-reload bridging.",
  "main": "dist/index.js",
  "bin": {
    "devtools-launcher": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "dev-tools",
    "cli",
    "launcher",
    "hot-reload",
    "socket-inspection",
    "developer-experience"
  ],
  "author": "Harold Villegas <contact@haroldvillegas.dev>",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^8.50.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.2.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.0.0",
    "dotenv": "^16.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hvilleg-dev/devtools-launcher.git"
  },
  "bugs": {
    "url": "https://github.com/hvilleg-dev/devtools-launcher/issues"
  },
  "homepage": "https://github.com/hvilleg-dev/devtools-launcher#readme"
}
